# ==========================================
# FRONTDESK AGENTS - ENVIRONMENT CONFIG
# ==========================================
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in your real keys from Twilio, Stripe, etc.
# 3. NEVER commit .env to Git (it is in .gitignore)

# --- TWILIO CONFIGURATION (Required for Calls) ---
# Get these from: https://console.twilio.com
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+18552833652  # Your purchased Twilio number
TWILIO_WEBHOOK_BASE=https://your-domain.com/api/v1/twilio

# --- STRIPE CONFIGURATION (Required for Payments) ---
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# --- AI MODEL CONFIGURATION ---
# NVIDIA API Key (for LLM inference)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx

# --- DATABASE & STORAGE ---
DATA_DIR=./data
DEBUG=True

# --- MODEL ROTATION (Optional) ---
PRIMARY_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
FALLBACK_MODEL=meta/llama-3.1-8b-instruct
